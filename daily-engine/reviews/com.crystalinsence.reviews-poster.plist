	<integer>600</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/gaki/ci-daily-engine/reviews/logs/poster.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/gaki/ci-daily-engine/reviews/logs/poster.err.log</string>
</dict>
</plist>
